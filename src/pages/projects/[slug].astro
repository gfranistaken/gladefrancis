---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio", ({ data }: CollectionEntry<"portfolio">) => !data.draft);
  return projects.map((project: CollectionEntry<"portfolio">) => ({
    params: { slug: project.id.replace(/\.md$/, "") },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"portfolio"> };
const { project } = Astro.props as Props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} - Glade Francis`} description={project.data.description}>
  <article class="px-4 md:px-6 lg:px-6 pt-20 pb-24 lg:pt-36 max-w-2xl">
    <header class="mb-10">
      <h1>{project.data.title}</h1>
      <p class="mt-3 text-base text-[var(--color-text-muted)] leading-relaxed">
        {project.data.description}
      </p>
      {project.data.externalUrl && (
        <a
          href={project.data.externalUrl}
          target="_blank"
          rel="noopener"
          class="inline-block mt-4 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
        >
          {project.data.externalUrl.replace(/^https?:\/\//, "")} &rarr;
        </a>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="mt-16 pt-8 border-t border-[var(--color-border)]">
      <a href="/projects" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
        &larr; Projects
      </a>
    </div>
  </article>
</BaseLayout>
