---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thanks - Glade Francis"
  description="Your message was sent."
  noindex
>
  <section class="px-4 md:px-6 lg:px-6 pt-20 pb-24 lg:pt-36 max-w-2xl">
    <h1>Thanks, got it.</h1>
    <p class="text-[var(--color-text-muted)] mt-4 text-base leading-relaxed">
      Your message is in my inbox. I'll get back to you soon.
    </p>
    <p class="mt-8">
      <a href="/" class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">Back to home</a>
    </p>
  </section>
</BaseLayout>
